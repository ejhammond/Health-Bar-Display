{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Renders vanilla-style heart health bars above mob heads",
  "authors": [
    "${mod_author}"
  ],
  "contact": {},
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.warwa.mobhealthbar.fabric.MobHealthBarFabric"
    ],
    "client": [
      "com.warwa.mobhealthbar.fabric.MobHealthBarFabricClient"
    ]
  },
  "mixins": [
    "mobhealthbar.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
