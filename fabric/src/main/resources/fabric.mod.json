{
  "schemaVersion": 1,
  "id": "mobhealthbar",
  "version": "1.0.0",
  "name": "Mob Health Bar",
  "description": "Renders vanilla-style heart health bars above mob heads",
  "icon": "assets/mobhealthbar/icon.png",
  "authors": ["warwa"],
  "contact": {},
  "license": "ARR",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.warwa.mobhealthbar.fabric.MobHealthBarFabric"
    ],
    "client": [
      "com.warwa.mobhealthbar.fabric.MobHealthBarFabricClient"
    ],
    "modmenu": [
      "com.warwa.mobhealthbar.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "mobhealthbar.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
